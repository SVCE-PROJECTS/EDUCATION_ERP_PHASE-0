# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Uploaded files — ignore everything under uploads/, including files
# written straight into its root (e.g. transfer.routes.js's upload dir),
# not just the documents/exports/photos subfolders.
uploads/*
!uploads/documents/
!uploads/exports/
!uploads/photos/
uploads/documents/*
uploads/exports/*
uploads/photos/*

# Keep empty upload directories
!uploads/documents/.gitkeep
!uploads/exports/.gitkeep
!uploads/photos/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
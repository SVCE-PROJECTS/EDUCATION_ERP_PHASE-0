# ─── Faculty Portal — Environment Variables ────────────────────────────────
#
# Copy this file to .env and fill in values for your local setup.
# .env is gitignored — never commit it.
#
# EXPO_PUBLIC_* variables are embedded at build time by Expo.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
#
# Emulator / simulator / web browser:
#   Leave blank or set to http://localhost:5000/api
#   (localhost resolves to the host machine from an emulator)
#
# Expo Go on a physical device (phone on same WiFi as your PC):
#   Set to your PC's LAN IP address, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api
#
#   To find your LAN IP on Windows:  ipconfig
#   To find your LAN IP on Mac:      ifconfig | grep "inet "
#
EXPO_PUBLIC_API_URL=http://localhost:5000/api

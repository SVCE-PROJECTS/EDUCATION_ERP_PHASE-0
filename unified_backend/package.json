{
  "name": "svce-erp-backend",
  "version": "1.0.0",
  "description": "SVCE Unified ERP Backend — Admin + HOD Portal + Faculty Portal",
  "main": "server.js", 
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql -U postgres -d education_erp -f ../database/unified_schema.sql",
    "db:seed": "psql -U postgres -d education_erp -f ../database/unified_seed_empty.sql",
    "db:create": "createdb -U postgres education_erp",
    "db:drop": "dropdb -U postgres --if-exists education_erp",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:schema && npm run db:seed",
    "prisma:migrate": "prisma migrate deploy --schema=../prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.22.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}

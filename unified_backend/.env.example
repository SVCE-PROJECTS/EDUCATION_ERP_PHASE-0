# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*


# ─── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=education_erp
PG_USER=postgres
PG_PASSWORD=your_postgresql_password


# ─── Database URL ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:fortresskey107@localhost:5432/education_erp"


# ─── JWT ──────────────────────────────────────────────────────────────────
# Leave blank or as the placeholder below and the server will auto-generate
# a secure random secret on first run and save it back here automatically.
# Once generated, do NOT change it — changing it invalidates all active tokens.
# In production you can set this explicitly to a value of your own.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h


# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
BASE_URL=http://localhost:5000


# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200


# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_FILE_LOGS=false


# ─── AI Checker ────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here


# ─── DuckDB Analytics ──────────────────────────────────────────────────────────
# Set to false to disable DuckDB entirely. PostgreSQL attendance writes are
# unaffected; analytics endpoints return 503 while disabled.
DUCKDB_ENABLED=true

# Path to the DuckDB file. The directory must exist and be writable.
# In production, confirm that the filesystem persists across restarts.
DUCKDB_PATH=./data/education_analytics.duckdb

# How often (minutes) to refresh the analytical snapshot from PostgreSQL.
# NOTE: In multi-replica deployments each process runs its own timer;
# use a distributed lock before scaling horizontally.
ANALYTICS_REFRESH_INTERVAL_MINUTES=15

# Whether to run a refresh on backend startup.
ANALYTICS_REFRESH_ON_START=true

# Age (minutes) after which the freshness indicator marks data as stale.
ANALYTICS_STALENESS_MINUTES=60

# Risk band thresholds (expressed as decimals between 0 and 1).
# DEMO DEFAULTS — not official VTU/SVCE policy. Adjust to institution rules.
ATTENDANCE_THRESHOLD_CRITICAL=0.60
ATTENDANCE_THRESHOLD_AT_RISK=0.75

# Default recovery target used when no target is specified by the client.
ATTENDANCE_RECOVERY_TARGET=0.75

# Maximum date range in days for a single analytics query.
ANALYTICS_MAX_DATE_RANGE_DAYS=366

# Pagination limits.
ANALYTICS_DEFAULT_PAGE_SIZE=50
ANALYTICS_MAX_PAGE_SIZE=200

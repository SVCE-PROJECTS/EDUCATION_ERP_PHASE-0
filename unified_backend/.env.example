# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*


# ─── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=education_erp
PG_USER=postgres
PG_PASSWORD=your_postgresql_password


# ─── Database URL ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:your_postgresql_password@localhost:5432/education_erp"


# ─── JWT ──────────────────────────────────────────────────────────────────
# Leave blank or as the placeholder below and the server will auto-generate
# a secure random secret on first run and save it back here automatically.
# Once generated, do NOT change it — changing it invalidates all active tokens.
# In production you can set this explicitly to a value of your own.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h


# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
BASE_URL=http://localhost:4000


# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200


# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_FILE_LOGS=false


# ─── AI Checker ────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
{
  "expo": {
    "name": "Faculty Portal",
    "slug": "faculty-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erpapp.faculty"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.erpapp.faculty"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "newArchEnabled": true
  }
}

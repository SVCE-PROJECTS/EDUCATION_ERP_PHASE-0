# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# CORS — use * for local dev (React Native / Expo Go doesn't enforce CORS).
# In production, set to your actual frontend origin, e.g. https://your-app.com
CORS_ORIGIN=*

# ─── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=education_erp
PG_USER=postgres
PG_PASSWORD=your_postgresql_password

# ─── Database URL (used by Prisma migrate only) ────────────────────────────
DATABASE_URL="postgresql://postgres:your_postgresql_password@localhost:5432/education_erp"

# ─── JWT ──────────────────────────────────────────────────────────────────
# IMPORTANT: Set this to a long random string (32+ chars) before first run.
# If left as the placeholder below, the server auto-generates and saves one.
# Once set, do NOT change it — all existing tokens will be invalidated.
# Generate a good secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
BASE_URL=http://localhost:5000

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_FILE_LOGS=false

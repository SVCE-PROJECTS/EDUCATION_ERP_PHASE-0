# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# CORS origins — comma-separated list of allowed origins.
# Development: include Expo Web ports (8081 default, 19006 legacy)
# React Native (Expo Go / mobile) does not enforce CORS so any origin works.
# Production: set to your actual frontend URL, e.g. https://your-app.com
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:19000

# ─── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=education_erp
PG_USER=postgres
PG_PASSWORD=your_postgresql_password

# ─── Database URL (used by Prisma migrate only) ────────────────────────────
DATABASE_URL="postgresql://postgres:your_postgresql_password@localhost:5432/education_erp"

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Once set, do NOT change — all existing tokens will be invalidated.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
BASE_URL=http://localhost:5000

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_FILE_LOGS=false

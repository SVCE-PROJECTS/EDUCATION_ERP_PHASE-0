# Admin Frontend — Environment Variables
# Copy to .env and fill in your values.
#
# EXPO_PUBLIC_API_URL is the base URL of unified_backend (/api included).
# - Android emulator: http://10.0.2.2:5000/api
# - iOS simulator / web / physical device: http://<your-LAN-IP>:5000/api
# - Production: https://your-backend.example.com/api

EXPO_PUBLIC_API_URL=http://localhost:5000/api

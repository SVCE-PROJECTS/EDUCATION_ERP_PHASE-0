{
  "expo": {
    "name": "Faculty Portal",
    "slug": "faculty-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.educorp.facultyportal"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-document-picker",
      "@react-native-community/datetimepicker"
    ]
  }
}

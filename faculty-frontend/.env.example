# Faculty Portal — environment variables
# Copy to .env and adjust if needed. Do NOT commit .env.
#
# ── API URL override (OPTIONAL) ───────────────────────────────────────────────
#
# Leave empty to use automatic host detection (recommended).
# Automatic detection uses the Metro dev server's LAN IP from Expo Constants
# so physical devices work without manual IP changes.
#
# Set explicitly only if automatic detection fails:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api
EXPO_PUBLIC_API_URL=

# ── Backend port ──────────────────────────────────────────────────────────────
# Must match the PORT in unified_backend/.env (default: 5000)
EXPO_PUBLIC_API_PORT=5000
